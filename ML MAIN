local function _findPlayerList(mid, dict)
  local battleId   = _memReadPtr(mid + OFF.battleId)
  local entriesPtr = _memReadPtr(dict + OFF.dictEntries)
  local entryCount = _memRead32(dict + OFF.dictCount)
  if not _ptrOk(entriesPtr) or entryCount <= 0 then return 0 end
  for i = 0, entryCount - 1 do
    local base = entriesPtr + OFF.arrayData + i * OFF.entrySize
    if _memRead32(base) >= 0 then
      local k = _memReadPtr(base + OFF.entryKey)
      if k == battleId and battleId ~= 0 then
        return _memReadPtr(base + OFF.entryVal)
      end
    end
  end
  for i = 0, entryCount - 1 do
    local base = entriesPtr + OFF.arrayData + i * OFF.entrySize
    if _memRead32(base) >= 0 then
      local cand = _memReadPtr(base + OFF.entryVal)
      if _ptrOk(cand) then
        local cnt = _memRead32(cand + OFF.listSize)
        if cnt >= 1 and cnt <= 10 then
          local items = _memReadPtr(cand + OFF.listItems)
          if _ptrOk(items) then
            local first = _memReadPtr(items + OFF.arrayData)
            if _ptrOk(first) then
              local hid  = _memRead32(first + OFF.heroId)
              local camp = _memRead32(first + OFF.camp)
              if hid >= 0 and hid <= 2000 and camp >= 1 and camp <= 2 then
                return cand
              end
            end
          end
        end
      end
    end
  end
  return 0
end

local function _scanPlayers(playerList)
  local blue, red = {}, {}
  local count    = _memRead32(playerList + OFF.listSize)
  local itemsPtr = _memReadPtr(playerList + OFF.listItems)
  if count <= 0 or count > 10 or not _ptrOk(itemsPtr) then
    return nil, nil, "Invalid player count: "..tostring(count)
  end
  for i = 0, count - 1 do
    local entry = _memReadPtr(itemsPtr + OFF.arrayData + i * 8)
    if _ptrOk(entry) then
      local hid  = _memRead32(entry + OFF.heroId)
      local camp = _memRead32(entry + OFF.camp)
      if hid >= 0 and hid <= 2000 and camp >= 1 and camp <= 2 then
        local uid  = _memReadPtr(entry + OFF.uid)
        local name = _readIL2String(_memReadPtr(entry + OFF.nameIL2))
        if name == "" then name = _readIL2String(_memReadPtr(entry + OFF.steamName)) end
        if name == "" then name = _readIL2String(_memReadPtr(entry + OFF.steamSimple)) end
        local p = {
          name    = name,
          heroId  = hid,
          spellId = _memRead32(entry + OFF.spellId),
          rank    = _getRank(_memRead32(entry + OFF.rankLv), _memRead32(entry + OFF.mythPts)),
          elo     = _memRead32(entry + OFF.elo),
          uid     = uid,
          zoneId  = _memRead32(entry + OFF.zoneId),
          isBot   = (uid >= 0 and uid <= 9),
        }
        if camp == 1 then blue[#blue+1] = p else red[#red+1] = p end
      end
    end
  end
  return blue, red, nil
end

local function _buildTeamBlock(team, label, idx)
  local lines = {}
  local humans, bots = 0, 0
  for _, p in ipairs(team) do
    if p.isBot then bots = bots + 1 else humans = humans + 1 end
  end
  lines[#lines+1] = "[ "..label.." ]"
  lines[#lines+1] = "  Humans: "..humans.."  |  Bots: "..bots
  lines[#lines+1] = "----------------------------"
  if #team == 0 then lines[#lines+1] = "  (empty)" end
  for i, p in ipairs(team) do
    local tag = p.isBot and "BOT" or "Player"
    lines[#lines+1] = ""
    lines[#lines+1] = "  "..(idx + i - 1)..". ".._str(p.name).."  ["..tag.."]"
    lines[#lines+1] = "     Hero   : ".._getHero(p.heroId)
    lines[#lines+1] = "     Spell  : ".._getSpell(p.spellId)
    lines[#lines+1] = "     Rank   : ".._str(p.rank)
    lines[#lines+1] = "     ELO    : ".._num(p.elo)
  end
  lines[#lines+1] = ""
  return table.concat(lines, "\n")
end

