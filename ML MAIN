function do_room_info()
  gg.toast("Scanning lobby...")
  local base = _getLibBase()
  if base == 0 then gg.alert("Error: libcsharp.so not found."); return end
  local page = _decodeADRP(base + OFF.func + 0x10)
  if page == 0 then gg.alert("Error: ADRP decode failed."); return end
  local obj  = _memReadPtr(page + OFF.staticObj)
  local mid  = _ptrOk(obj) and _memReadPtr(obj + OFF.mid) or 0
  local dict = _ptrOk(mid) and _memReadPtr(mid + OFF.dict) or 0
  if not _ptrOk(dict) then gg.alert("Open this at the Hero Select screen."); return end
  local pList = _findPlayerList(mid, dict)
  if not _ptrOk(pList) then gg.alert("No player list found.\nRun at Hero Select before banning."); return end
  local blue, red, err = _scanPlayers(pList)
  if err then gg.alert("Error: "..err); return end
  local totalH, totalB = 0, 0
  for _, p in ipairs(blue) do if p.isBot then totalB=totalB+1 else totalH=totalH+1 end end
  for _, p in ipairs(red)  do if p.isBot then totalB=totalB+1 else totalH=totalH+1 end end
  local out =
    "============================\n" ..
    "       LOBBY SCANNER\n" ..
    "  Total: "..totalH.." Players  "..totalB.." Bots\n" ..
    "============================\n\n" ..
    _buildTeamBlock(blue, "BLUE TEAM", 1).."\n"..
    _buildTeamBlock(red,  "RED TEAM",  #blue + 1)
  gg.alert(out)
end

