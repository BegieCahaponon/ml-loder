local function roomInfo()
    gg.toast("Scanning lobby...")

    local base = getLibBase()
    if base == 0 then
        gg.alert("Error: libcsharp.so not found.")
        return
    end

    local page = decodeADRP(base + OFF.func + 0x10)
    if page == 0 then
        gg.alert("Error: ADRP decode failed.")
        return
    end

    local obj  = memReadPtr(page + OFF.staticObj)
    local mid  = ptrOk(obj) and memReadPtr(obj + OFF.mid) or 0
    local dict = ptrOk(mid) and memReadPtr(mid + OFF.dict) or 0

    if not ptrOk(dict) then
        gg.alert("Open this at the Hero Select screen.")
        return
    end

    local pList = findPlayerList(mid, dict)
    if not ptrOk(pList) then
        gg.alert("No player list found.\nRun at Hero Select before banning.")
        return
    end

    local blue, red, err = scanPlayers(pList)
    if err then
        gg.alert("Error: " .. err)
        return
    end

    local totalH, totalB = 0, 0
    for _, p in ipairs(blue) do if p.isBot then totalB=totalB+1 else totalH=totalH+1 end end
    for _, p in ipairs(red)  do if p.isBot then totalB=totalB+1 else totalH=totalH+1 end end

    local out =
        "============================\n" ..
        "       LOBBY SCANNER\n" ..
        "  Total: " .. totalH .. " Players  " .. totalB .. " Bots\n" ..
        "============================\n\n" ..
        buildTeamBlock(blue, "BLUE TEAM", 1) .. "\n" ..
        buildTeamBlock(red,  "RED TEAM",  #blue + 1)

    gg.alert(out)
end

