local function memRead32(addr)
    if not addr or addr == 0 then return 0 end
    local s, v = pcall(gg.getValues, {{address=addr, flags=4}})
    return (s and v and v[1] and v[1].value) or 0
end

local function memReadPtr(addr)
    if not addr or addr == 0 then return 0 end
    local s, v = pcall(gg.getValues, {{address=addr, flags=32}})
    return (s and v and v[1] and v[1].value) or 0
end

local function memReadU16(addr)
    if not addr or addr == 0 then return 0 end
    local s, v = pcall(gg.getValues, {{address=addr, flags=2}})
    return (s and v and v[1] and v[1].value) or 0
end

local function ptrOk(p)
    if not p or p == 0 or p < 0x10000 then return false end
    local s, v = pcall(gg.getValues, {{address=p, flags=4}})
    return s and v ~= nil and #v > 0
end

local function decodeADRP(addr)
    local raw = memRead32(addr)
    if raw == 0 or (raw & 0x9F000000) ~= 0x90000000 then return 0 end
    local lo  = (raw >> 29) & 0x3
    local hi  = (raw >> 5)  & 0x7FFFF
    local imm = (hi << 2) | lo
    if (imm & 0x100000) ~= 0 then imm = imm - 0x200000 end
    return (addr & ~0xFFF) + (imm << 12)
end

local function readIL2String(ptr)
    if not ptrOk(ptr) then return "" end
    local len = memRead32(ptr + OFF.strLen)
    if len <= 0 then return "" end
    if len > 64 then len = 64 end
    local buf = {}
    for i = 0, len - 1 do
        local ch = memReadU16(ptr + OFF.strData + i * 2) & 0xFFFF
        if ch == 0 then break end
        buf[#buf+1] = (ch >= 32 and ch <= 126) and string.char(ch) or "?"
    end
    return table.concat(buf)
end

local function getHero(id)
    return HEROES[id] or ("Hero#" .. tostring(id or "?"))
end

local function getRank(lv, mp)
    lv = lv or 0
    mp = mp or 0
    if lv > 135 then
        local pts = math.floor((mp + 1260) / 10)
        return pts >= 600 and ("Myth Glory " .. pts) or ("Mythic " .. pts)
    end
    return RANKS[lv] or ("Rank " .. lv)
end

local function getSpell(id)
    return SPELLS[id] or tostring(id or "?")
end

local function str(v)  return (v and v ~= "") and v or "Unknown" end
local function num(v)  return tostring(v or 0) end

local function getLibBase()
    local list = gg.getRangesList("libcsharp.so")
    if not list or #list == 0 then return 0 end
    for _, r in ipairs(list) do
        if r.state == "Xa" then return r.start end
    end
    return 0
end

local function findPlayerList(mid, dict)
    local battleId   = memReadPtr(mid + OFF.battleId)
    local entriesPtr = memReadPtr(dict + OFF.dictEntries)
    local entryCount = memRead32(dict + OFF.dictCount)

    if not ptrOk(entriesPtr) or entryCount <= 0 then return 0 end

    for i = 0, entryCount - 1 do
        local base = entriesPtr + OFF.arrayData + i * OFF.entrySize
        if memRead32(base) >= 0 then
            local k = memReadPtr(base + OFF.entryKey)
            if k == battleId and battleId ~= 0 then
                return memReadPtr(base + OFF.entryVal)
            end
        end
    end

    for i = 0, entryCount - 1 do
        local base = entriesPtr + OFF.arrayData + i * OFF.entrySize
        if memRead32(base) >= 0 then
            local cand = memReadPtr(base + OFF.entryVal)
            if ptrOk(cand) then
                local cnt = memRead32(cand + OFF.listSize)
                if cnt >= 1 and cnt <= 10 then
                    local items = memReadPtr(cand + OFF.listItems)
                    if ptrOk(items) then
                        local first = memReadPtr(items + OFF.arrayData)
                        if ptrOk(first) then
                            local hid  = memRead32(first + OFF.heroId)
                            local camp = memRead32(first + OFF.camp)
                            if hid >= 0 and hid <= 2000 and camp >= 1 and camp <= 2 then
                                return cand
                            end
                        end
                    end
                end
            end
        end
    end
    return 0
end

local function scanPlayers(playerList)
    local blue, red = {}, {}
    local count    = memRead32(playerList + OFF.listSize)
    local itemsPtr = memReadPtr(playerList + OFF.listItems)

    if count <= 0 or count > 10 or not ptrOk(itemsPtr) then
        return nil, nil, "Invalid player count: " .. tostring(count)
    end

    for i = 0, count - 1 do
        local entry = memReadPtr(itemsPtr + OFF.arrayData + i * 8)
        if ptrOk(entry) then
            local hid  = memRead32(entry + OFF.heroId)
            local camp = memRead32(entry + OFF.camp)
            if hid >= 0 and hid <= 2000 and camp >= 1 and camp <= 2 then
                local uid  = memReadPtr(entry + OFF.uid)
                local name = readIL2String(memReadPtr(entry + OFF.nameIL2))
                if name == "" then name = readIL2String(memReadPtr(entry + OFF.steamName)) end
                if name == "" then name = readIL2String(memReadPtr(entry + OFF.steamSimple)) end

                local p = {
                    name    = name,
                    heroId  = hid,
                    spellId = memRead32(entry + OFF.spellId),
                    rank    = getRank(memRead32(entry + OFF.rankLv), memRead32(entry + OFF.mythPts)),
                    elo     = memRead32(entry + OFF.elo),
                    uid     = uid,
                    zoneId  = memRead32(entry + OFF.zoneId),
                    isBot   = (uid >= 0 and uid <= 9),
                }

                if camp == 1 then blue[#blue+1] = p else red[#red+1] = p end
            end
        end
    end
    return blue, red, nil
end

local function buildTeamBlock(team, label, idx)
    local lines = {}
    local humans, bots = 0, 0
    for _, p in ipairs(team) do
        if p.isBot then bots = bots + 1 else humans = humans + 1 end
    end

    lines[#lines+1] = "[ " .. label .. " ]"
    lines[#lines+1] = "  Humans: " .. humans .. "  |  Bots: " .. bots
    lines[#lines+1] = "----------------------------"

    if #team == 0 then
        lines[#lines+1] = "  (empty)"
    end

    for i, p in ipairs(team) do
        local tag = p.isBot and "BOT" or "Player"
        lines[#lines+1] = ""
        lines[#lines+1] = "  " .. (idx + i - 1) .. ". " .. str(p.name) .. "  [" .. tag .. "]"
        lines[#lines+1] = "     Hero   : " .. getHero(p.heroId)
        lines[#lines+1] = "     Spell  : " .. getSpell(p.spellId)
        lines[#lines+1] = "     Rank   : " .. str(p.rank)
        lines[#lines+1] = "     ELO    : " .. num(p.elo)
    end

    lines[#lines+1] = ""
    return table.concat(lines, "\n")
end

